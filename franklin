#!/usr/bin/env python3
"""Thin launcher for the franklin_bridge CLI.

Lets you run ./franklin from a checkout without installing anything.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from franklin_bridge.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
